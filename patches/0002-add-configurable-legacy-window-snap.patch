+    <key name="legacy-window-snap" type="b">
+      <default>true</default>
+      <summary>Enable Shift for legacy window snapping</summary>
+      <description>
+        When enabled, holding Shift while moving a window enables legacy
+        window snapping and edge resistance. Disable this when Shift is used
+        by another window-management workflow.
+      </description>
+    </key>
+
